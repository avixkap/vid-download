{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VidDownload",
  "version": "1.0.1",
  "identifier": "com.viddownload.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "npm run build:vite"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "VidDownload",
        "width": 1120,
        "height": 780,
        "minWidth": 920,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0a0a0b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "avixkap",
    "copyright": "Copyright (c) 2026 avixkap. MIT License.",
    "homepage": "https://github.com/avixkap/vid-download",
    "license": "MIT",
    "category": "Utility",
    "shortDescription": "Download video and audio from 1000+ sites",
    "longDescription": "VidDownload is a small desktop front-end for yt-dlp: paste a link, pick the quality and download video or audio from YouTube, TikTok, X, Instagram, Vimeo and 1000+ other sites.",
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
